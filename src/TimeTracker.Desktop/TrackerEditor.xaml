<Window x:Class="TimeTracker.Desktop.TrackerEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New tracker" Style="{StaticResource AppWindow}" Width="390" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AutomationProperties.AutomationId="TrackerEditor">
    <StackPanel Style="{StaticResource DialogContent}">
        <Label Content="Card _reference" Target="LabelInput" Foreground="{DynamicResource TextPrimary}" Padding="0,0,0,6" />
        <TextBox x:Name="LabelInput" MaxLength="120" AutomationProperties.AutomationId="TrackerLabel" AutomationProperties.Name="Card reference" />
        <Label Content="_Description (optional, 160 characters)" Target="DescriptionInput" Foreground="{DynamicResource TextPrimary}" Padding="0,0,0,6" Margin="0,16,0,0" />
        <TextBox x:Name="DescriptionInput" MaxLength="160" AutomationProperties.AutomationId="TrackerDescription" AutomationProperties.Name="Description, optional, up to 160 characters" />
        <TextBlock Text="Row border color" Margin="0,16,0,8" />
        <ListBox x:Name="ColorInput" BorderThickness="0" Background="Transparent" SelectedIndex="0"
                 ItemContainerStyle="{StaticResource ColorChoiceItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Row border color" AutomationProperties.AutomationId="TrackerColor">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding Color}" Width="32" Height="32" CornerRadius="16" ToolTip="{Binding Name}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="ValidationMessage" Foreground="{DynamicResource WarningText}" TextWrapping="Wrap" Margin="0,12,0,0" />
        <StackPanel Style="{StaticResource DialogActions}">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource RaisedButton}" Margin="0,0,8,0" />
            <Button x:Name="SaveTrackerButton" Content="Save tracker" IsDefault="True" Click="SaveTracker" Style="{StaticResource RaisedButton}" AutomationProperties.AutomationId="SaveTracker" />
        </StackPanel>
    </StackPanel>
</Window>
